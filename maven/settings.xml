<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for authenticating to GitHub Packages.
  In CI (GitHub Actions), GITHUB_ACTOR and GITHUB_TOKEN are already set by the runner.
  For local/manual publishing, set GITHUB_ACTOR to your GitHub username and GITHUB_TOKEN
  to a personal access token with read:packages/write:packages scope before running mvn.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
